{
  "name": "rtckit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless, embeddable real-time calling SDK — workspace root + build/release tooling for the npm-published @elloloop/rtckit-* TypeScript libraries.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elloloop/rtckit.git"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "ci:local": "pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/publish-oidc.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "tsup": "8.5.1",
    "turbo": "2.5.5",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
